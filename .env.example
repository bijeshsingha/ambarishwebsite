# ==========================================
# Hotel Ambarish Website Environment Configuration
# ==========================================

# 1. Management Notification Email
# All room bookings and banquet/meeting enquiries will be delivered to this inbox
NOTIFICATION_EMAIL=reservation.ambarish@gmail.com

# 2. SMTP Email Dispatch (e.g. Gmail, Hostinger, GoDaddy, Brevo, AWS SES, Resend)
# For Gmail: Use an "App Password" generated in Google Account Security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=reservation.ambarish@gmail.com
SMTP_PASS=your_gmail_app_password_here

# 3. Booking Reference Sequence (starts at 0001)
INITIAL_RESERVATION_NUMBER=0

# 4. Optional: Direct PMS Sync (e.g. Hotel OS running on port 3000)
# PMS_WEBHOOK_URL=http://localhost:3000/api/v1/reservations
# PMS_API_SECRET=your_pms_secret_key

# 5. Optional: WhatsApp Alert / Webhook URL (e.g., Google Sheet webhook, Make, Zapier, Twilio)
# WEBHOOK_URL=https://script.google.com/macros/s/.../exec
